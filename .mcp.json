{
  "mcpServers": {
    "planning": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/planning_mcp.py"
      ]
    },
    "codex-claude-desktop-bridge": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/vendor/codex-claude-desktop-bridge/scripts/mcp.mjs"
      ],
      "env_vars": [
        "CODEX_APP_TOOLS_PIPE_PATH",
        "CODEX_THREAD_ID",
        "CLAUDE_CODE_MESSAGING_SOCKET",
        "LOCALAPPDATA",
        "USERPROFILE",
        "HOME",
        "PATH",
        "CLAUDE_CONFIG_DIR",
        "CODEX_CLAUDE_BRIDGE_STATE_DIR",
        "CODEX_CLAUDE_BRIDGE_REGISTRY_DIR",
        "CODEX_CLAUDE_BRIDGE_CODEX_BIN",
        "CODEX_CLAUDE_BRIDGE_DAEMON",
        "CODEX_HOME",
        "CODEX_CLAUDE_BRIDGE_SSH_HOST"
      ]
    }
  }
}
